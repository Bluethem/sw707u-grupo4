HTTP_ADDR=:8080
# Usado por procesos DENTRO de Compose (api/worker/seed). No cambies el host "postgres".
DATABASE_URL=postgres://ff:ff@postgres:5432/flowfacture?sslmode=disable
REDIS_URL=redis://redis:6379/0
SESSION_TTL=8h
MIGRATE_ON_START=true
POSTGRES_USER=ff
POSTGRES_PASSWORD=ff
POSTGRES_DB=flowfacture
# Puerto publicado en el host. Si 5432 ya lo usa otro Postgres local, usa 55432.
POSTGRES_HOST_PORT=5432
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
SUNAT_FAKE_MODE=accept
SECRETS_MASTER_KEY=change-me-to-a-32-byte-secret-key!
