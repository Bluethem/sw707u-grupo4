HTTP_ADDR=:8080
# Usado por procesos DENTRO de Compose (api/worker/seed). No cambies el host "postgres".
DATABASE_URL=postgres://ff:ff@postgres:5432/flowfacture?sslmode=disable
REDIS_URL=redis://redis:6379/0
SESSION_TTL=8h
MIGRATE_ON_START=true
POSTGRES_USER=ff
POSTGRES_PASSWORD=ff
POSTGRES_DB=flowfacture
# Puerto publicado en el host. Si 5432 ya lo usa otro Postgres local, usa 55432.
POSTGRES_HOST_PORT=5432
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
SUNAT_FAKE_MODE=accept
SECRETS_MASTER_KEY=change-me-to-a-32-byte-secret-key!
BLOB_DIR=./data/blobs
FRONTEND_PUBLIC_URL=http://localhost:3000

# --- SUNAT (opcional) ----------------------------------------------------------
# Si el set mínimo está completo, api/worker usan firma PKCS#12 + cliente SOAP.
# Si falta alguna variable, se usa Fake (SUNAT_FAKE_MODE) sin llamar a SUNAT.
#
# Set mínimo para beta:
#   SUNAT_RUC, SUNAT_SOL_USER, SUNAT_SOL_PASSWORD,
#   SUNAT_CERT_PATH, SUNAT_CERT_PASSWORD
#
# Beta (default con credenciales):
#   https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
# AVISO SUNAT: el servicio beta es SOLO para probar estructura XML.
# No lo uses para estrés, ráfagas ni alto volumen — pueden bloquear la IP.
# Deja SUNAT_MIN_INTERVAL >= 30s y envía pocos comprobantes de prueba.
#
#SUNAT_RUC=20123456789
#SUNAT_SOL_USER=MODDATOS
#SUNAT_SOL_PASSWORD=
#SUNAT_CERT_PATH=/path/al/certificado.pfx
#SUNAT_CERT_PASSWORD=
#SUNAT_ENV=beta
#SUNAT_WS_URL=
#SUNAT_MIN_INTERVAL=30s
#
# Producción (impacto tributario REAL — no usar para “probar”):
# Condiciones:
#   1) Credenciales y certificado del emisor real.
#   2) SUNAT_ENV=production
#   3) SUNAT_ALLOW_PRODUCTION=true
#   4) Entender que cada aceptación es un CPE válido ante SUNAT.
#SUNAT_ENV=production
#SUNAT_ALLOW_PRODUCTION=false
